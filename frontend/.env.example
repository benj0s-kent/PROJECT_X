# ASP.NET Core backend from backend/Properties/launchSettings.json
NEXT_PUBLIC_API_BASE_URL=http://localhost:5178/api

# Пока backend-эндпоинты активностей не реализованы, frontend работает на моках.
# Поставьте false после появления реальных /api/activities и /api/users/me.
NEXT_PUBLIC_USE_MOCK_API=true
